{
  "extends": "gemsorg",
  "parser": "babel-eslint",
  "env": {
    "browser": true,
    "es6": true,
    "jest": true
  },
  "rules": {
    "class-methods-use-this":  ["off"],
    "react/jsx-filename-extension": [1, { "extensions": [".js", ".jsx"] }],
    "react/prefer-stateless-function": ["off"],
    "react/prop-types": [2, { "ignore": ['children'] }]
  }
}
