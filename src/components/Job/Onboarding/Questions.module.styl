@import 'common/uikit/components';
@import 'common/uikit/colors';
@import 'common/uikit/layout';

.btnPink
  button('large', 'pink')
  margin: 10px 0
  @media(min-width: 768px)
    width: 200px!important
    min-width: 200px!important

.btnAqua
  button('medium', 'aqua')
  margin: 10px 0
  margin-top:40px
  position: relative
  @media(min-width: 768px)
    width: 100px!important
    min-width: 100px!important
  span
    small
      font-size: 20px

.btnDisabledSmall
  button('medium', 'grey')
  margin: 10px 0
  margin-top:40px
  position: relative
  cursor: not-allowed;
  @media(min-width: 768px)
    width: 100px!important
    min-width: 100px!important
  span
    small
      font-size: 20px;

.questionHeader
  .headerHeading
    background: #1c2541
    display: flex
    justify-content: left
    align-items: center
    padding: 15px
    h5
      color:color-white
      padding-left: 20px
      @media(min-width: 768px)
        font-size:18px
    button
      width:137px!important
      min-width: 130px!important
    @media(min-width: 1150px)
     padding: 26px 70px
    @media(min-width: 1440px)
     padding: 26px 122px
  .questInfo
    display: flex
    justify-content: space-between
    padding: 26px 15px
    border-bottom: 1px solid #ececec

    h4
      font-weight: 600
      color: #9fa2b2
      font-size: 16px
      @media(min-width: 768px)
        font-size: 18px
    .col1
      span
        color: #ff7092
        padding-right: 6px
        font-weight: 800
        font-size: 20px
        position: relative
        @media(min-width: 768px)
          font-size: 25px
          top: 0px  
          font-weight: 600
    .col2
      span
        color: #191f40
        padding-right: 6px
        font-weight: 800
        font-size: 20px
        position: relative
        @media(min-width: 768px)
          font-size: 25px
          top: 0px
          font-weight: 600
    @media(min-width: 1150px)
     padding: 26px 70px
    @media(min-width: 1440px)
      padding: 26px 122px

.taskLinks
  color:color-pink
  margin: 31px 0
  font-weight: 600
  span
    cursor:pointer
    padding: 0 5px
    &:hover
     text-decoration:underline

// Columns
.oneColumn
  text-align: left

.twoColumn
  text-align: left
  @media(min-width: 768px)
      display: flex
      flex-wrap: wrap
      justify-content: center
      text-align: left
.yesOrNo
  @media(min-width: 768px)
    display: flex
    justify-content: center

.btnTrans
    button('large', 'transparent')
    margin: 20px 0

.btnTransActive
    button('large', 'pink')
    margin: 20px 0

.phDarkGrey
  color: color-text-1