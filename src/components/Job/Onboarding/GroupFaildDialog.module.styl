@import '~@gemsorg/components/src/uikit/colors'
@import '~@gemsorg/components/src/uikit/font'
@import '~@gemsorg/components/src/uikit/consts'

.container
  box-sizing: border-box;
  padding: 0 80px 50px

  @media(max-width: 660px)
    width: 100%;
    padding: 0 10px

.inner
  box-sizing: border-box;

  padding: 35px 0

  width: 400px;

  display: flex;
  flex-direction: column
  align-items: center;


  @media(max-width: 660px)
    width: 100%;

.title
  font(font-preset[headline])
  color: color-text-1
  margin-bottom: 30px;

.message
  font(font-preset[menu])
  color: color-text-gray-1
  margin-bottom: 50px;
  text-align: center;

.tries
  font(font-preset[headline])
  color: color-text-1
  margin-right: 5px

.actions
  padding: 10px 0

.ok
  margin-left: 30px
  padding: 0 40px

.link
  display: inline-block;
  padding: 0 40px
