@import '../common/uikit/mixins'

.container
  position: relative
  display: block
  box-sizing: border-box
  background-color: #ffffff
  margin-left: 10%
  margin-right: 10%
  margin-top: 12.5px
  padding-bottom: 12.5px

.login
  button()
  width: calc(174px / 1.5)
  height: calc(64px / 1.5)
  margin-top: 17.5px


.instructions
  font-family: Poppins
  font-size: 10.6px
  font-weight: 400
  text-align: center
  margin: auto
  display: block

.screenShot
  padding-bottom: 7.5px
  padding-top: 50px
  width: calc(414px / 1.5)
  height: calc(556px / 1.5)
  margin: auto
  text-align: center
  display: block
