@import 'common/uikit/colors'
@import 'common/uikit/layout'
@import 'common/uikit/font'

.gem-content
  box-sizing: border-box;
  height: 100%

  &-title
    box-sizing: border-box;

    font(font-preset[headline], false, false, 70px)
    height: 70px

    padding-left: 50px

    text-overflow: ellipsis
    overflow: hidden
    white-space: nowrap

    background-color: color-white
    box-shadow: inset 0 -1px 0 0 color-grey
