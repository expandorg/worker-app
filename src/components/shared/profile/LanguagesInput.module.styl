@import 'common/uikit/colors'
@import 'common/uikit/font'

.input
  :global(.gem-autocomplete-suggestion)
    color: color-text-1

    &:hover
      color: color-pink


.lang
  display: inline-block;
  box-sizing: border-box;

  padding: 0 8px;
  border-radius: 2px;

  font(font-preset[normal], false, false, 24px)
  background-color: color-pink
  color: color-white

  margin-right: 10px;
  margin-top: 7px;

.delete
  box-sizing: border-box;
  padding: 0
  margin-left: 5px;

  font(font-preset[normal])

  color: color-white
  background-color: transparent;
  cursor: pointer;
  outline: none;
