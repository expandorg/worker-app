@import '~@gemsorg/components/src/uikit/font'
@import '~@gemsorg/components/src/uikit/colors'

.container
  border: 1px solid color-pink
  display: inline-block;
  border-radius: 2px

.button
  border-radius: 0px
  color: color-pink
  width: 120px;

  &:first-child
    border-right: 1px solid color-pink;

.selected
  background-color: color-pink
  color: color-white
