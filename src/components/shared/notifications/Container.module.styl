@import 'common/uikit/colors'
@import 'common/uikit/font'

.container
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 100%;
  padding: 0 30px;

.content
  flex-grow: 1;

.clear
  height 16px
  line-height: 16px
  font-size: 14px

  border-radius: 0
  background: none
  color: #cacaca
  outline: none;
  cursor: pointer;

  &:hover
    color: darken(#cacaca, 20%);
