@import '~@expandorg/uikit/colors'
@import '~@expandorg/uikit/font'
@import '~@expandorg/uikit/consts'

.container
  box-sizing: border-box;
  text-align: center;
  padding: 0 (2 * s-padding-big) (2 * s-padding-big)

  @media(max-width: 660px)
    padding-left: s-padding-medium
    padding-right: s-padding-medium

.description
  font(font-preset[menu])
  color: color-text-1
  text-align: center;
  margin-top: s-margin-big

.screenshot
  display: block
  max-width: 800px;
  width: 100%;
  margin-top: s-margin-big
