@import '~@expandorg/uikit/colors'
@import '~@expandorg/uikit/font'
@import '~@expandorg/uikit/size'

.birthdate
  display flex

  :global(.gem-dateinput-dropdown)
    box-sizing: border-box
    position relative

    margin: 0 12px
    font(body, false, false, 43px)
    color: color-white
    height 43px
    border-bottom: 1px solid color-white

    &:after
      position absolute
      top: calc(50% - 3px)
      right: 0
      content: " "

      padding: 0 0 0 2px

      width: 11px
      height 6px

      background-position:center
      background-size: contain
      background-repeat: no-repeat
      background-origin: border-box
      background-image: url('./arrow-down.svg')
