@import '~@expandorg/uikit/colors'
@import '~@expandorg/uikit/font'

.input
  :global(.gem-input)
    color: color-light-blue
    border-bottom: 2px solid color-heavy-blue

.autocomplete
  :global(.gem-input)
    color: color-light-blue
    border-bottom: none

  :global(.gem-autocomplete-input)
    border-bottom: 2px solid color-heavy-blue

  :global(.gem-autocomplete-suggestions)
    max-height 350px


.dropdown
  :global(.gem-dropdown)
    &-content
      border-bottom: 2px solid color-heavy-blue

      &-val
        color: color-light-blue

      &-label
        color: #666

.field
  :global(.DayPickerInput)
    input
      color: color-light-blue
      border-bottom: 2px solid color-heavy-blue
      font(body)

      &::placeholder
        color: #666


