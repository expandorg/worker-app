@import '~@expandorg/uikit/colors'
@import '~@expandorg/uikit/font'
@import '~@expandorg/uikit/size'

.container
  box-sizing: border-box
  width: 100%
  height: 100%

  padding: 0 15px 15px

  display flex
  flex-direction: column

.content
  flex-grow: 1
  display: flex
  justify-content: center


.form
  box-sizing: border-box

  margin-top: 20vh

  max-width: 550px
  min-width: 550px


.title
  font(h2-bold)
  color: color-light-blue
  text-align: center
  margin-bottom: 30px

.actions
  display: flex
  justify-content: flex-end

  > *
    margin-left: 15px
