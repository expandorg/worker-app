@import '~@gemsorg/components/src/uikit/colors'
@import '~@gemsorg/components/src/uikit/font'
@import '~@gemsorg/components/src/uikit/consts'

.container
  box-sizing: border-box;
  padding: 30px 100px 100px

  @media(max-width: 660px)
    width: 100%;
    padding: 0 10px

.description
  font(font-preset[subheader])
  color: color-text-1

.form
  margin-top: 20px;

.row
  display: flex;
  align-content: center;

  @media(max-width: 660px)
    flex-direction: column;


.input
  height: 50px;

.submit
  width: 150px;
  margin-left: 10px;

  @media(max-width: 660px)
    width: 100%;
    margin-left: 0;
    margin-top: 10px;

.resend
  display: flex;
  align-items: center;

  height: 50px;

.resendText
  font(font-preset[normal])
  color: color-text-1

.resendButton
  box-sizing: border-box;
  text-align: center;

  font(font-preset[normal], false, false, 20px)
  height: 22px
  border-radius: 2px
  padding: 0 10px;
  margin-left: 10px;

  border: 1px solid color-pink
  color: color-pink
  outline: 0
  cursor: pointer;
