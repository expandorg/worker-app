@import '~@gemsorg/components/src/uikit/font'

.container
  display: flex;
  align-items: center;
  justify-content: center;

  box-sizing: border-box;
  height: 50px;
  background: #3A506B


.confirm
  font(font-preset[menu])
  background: transparent;
  text-decoration: underline;
  cursor pointer;
  outline: none;
  color: lighten(#3A506B, 90%)

  &:hover
    color: lighten(#3A506B, 99%)
