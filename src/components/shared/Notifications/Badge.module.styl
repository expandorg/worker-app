@import '~@expandorg/uikit/colors';
@import '~@expandorg/uikit/font'

.container
  margin-right: 37px

  position: relative
  cursor: pointer

.counter
  position: absolute
  right: -9px
  top: 0

  width: 20px
  height: 20px

  border-radius: 50%
  background: color-pink
  color: color-white
  font(small-text-bold, 900, 12px, 20px)

  text-align: center

.list
  position: absolute
  top: 25px
  right: 0

  width: 200px;
  height: 40px;


  background: color-white
  box-shadow: heavy-shadow



