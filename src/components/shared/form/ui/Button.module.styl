@import 'common/uikit/components';
@import 'common/uikit/colors';
@import 'common/uikit/layout';

.button
  padding: 0 20px;
  min-width: 100px;

.smallSize
  button('small', null)

.mediumSize
  button('medium', null)

.largeSize
  button('large', null)

.pinkTheme
  pink()
.whiteTheme
  white()
.transparentTheme
  transparent()
.blueTheme
  blue()
.aquaTheme
  aqua()
.blueTransparentTheme
  blue-transparent()

.linkTheme
  color: color-text-1
  font-weight: 500;

  &:hover
    text-decoration: underline;
