
.info
  display: flex;
  align-items: center;

.spacer
  width: 1px;
  height: 30px;
  opacity: 0.25
  background-color: #1C2541

.number
  color: rgba(28, 37, 65, 1)
  font-size: 26px;
  line-height: 26px

.title
  font-size: 16px;
  font-weight: 600;
  color: rgba(28, 37, 65, 0.5)
  text-transform:uppercase;
  line-height: 26px

.question
  margin-top: 17px;
  padding-left: 100px;
  padding-right: 100px;

  @media(max-width: 768px)
    padding-left: 0;
    padding-right: 0;
