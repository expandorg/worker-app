@import 'components/common/uikit/components';
@import 'components/common/uikit/colors';
@import 'components/common/uikit/layout';

.container
  text-align: center
  display: block

.description
  margin: 5%
  display: block

.video
  position: absolute
  top: 0
  left: 0
  height: 100%
  width: 100%

.videoInnerWrapper
  position: relative
  padding-bottom: 56.2%
  width: 100%
  height: 100%

.videoWrapper
  width: 100%
  height: 100%
  max-height: 288px
  max-width: 525px
  margin: auto

.install
  btn()
  box-sizing: border-box;
  text-decoration: none;
  color: color-white
  margin-top: 16px
  display: inline-block;
  width: auto;
  padding: 0 s-padding-medium
  line-height: 42px;
