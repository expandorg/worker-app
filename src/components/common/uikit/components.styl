@import './colors';

panel()
  padding: 25px
  border-radius: 4px
  background-color: color-white
  border: solid 1px color-grey
  display: block
  margin: 25px

loading()
  display: block
  margin: auto
  height: 150px
  width: 150px
  background: url(/images/loading-animation.gif) no-repeat left top
  background-size: contain
  position: relative
  top: 35%
  transform: translateY(-50%)

flexpanel()
  padding: 25px
  margin: 25px

  border-radius: 4px
  background-color: color-white
  border: solid 1px color-grey
  display: flex
  flex-wrap: wrap
  align-items: center
  justify-content: center

button()
  width: 132px
  height: 42px
  border-radius: 4px
  background-color: color-pink
  font-size: 16px
  text-align: center
  display: block
  margin-left: auto
  margin-right: auto
  border: 0
  cursor: pointer

  &:focus
    outline: 0px

  &:hover
    background-image: linear-gradient(to bottom right, color-pink, color-pink-light)

  &:disabled
    background-color: color-grey
    &:hover
      background-image: none
