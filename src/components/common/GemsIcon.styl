@import 'common/uikit/colors'
@import 'common/uikit/layout'
@import 'common/uikit/font'

.gem-gemicon
  display: inline-block;
  box-sizing: border-box;

  position: relative;

  width: 16px
  height: 16px;
  top: 2px;

  content: ' '
  transform: scale(1.2);

  background-position:center;
  background-size: cover;
  background-repeat: no-repeat;
  background-origin: border-box;
  background-image: url(./gems.svg);
