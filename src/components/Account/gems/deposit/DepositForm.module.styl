@import 'common/uikit/colors';
@import 'common/uikit/layout';
@import 'common/uikit/components';

.container
  box-sizing: border-box;
  padding: 10px 60px 50px
  max-width: 800px;

  @media(max-width: 660px)
    width: 100%;
    padding: 0 10px

.description
  @media(max-width: 660px)
    padding: 0 20px

.p
  font(font-preset[subheader])
  color: color-text-1
  margin-bottom: 10px;

.balance
  color: lighten(color-blue, 20%)
  font-weight: 600

.form
  margin-top: 20px;
  margin-bottom: 40px;

.row
  display: flex;
  align-content: center;

  @media(max-width: 660px)
    flex-direction: column;

.input
  input()
  width: 100%;
  height: 50px;

.submit
  button('large', 'pink')
  width: 150px;
  margin-left: 10px;

  @media(max-width: 660px)
    width: 100%;
    margin-left: 0;
    margin-top: 10px;

.error
  margin-top: s-margin-medium
