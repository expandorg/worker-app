@import '~@gemsorg/components/src/uikit/colors'
@import '~@gemsorg/components/src/uikit/font'
@import '~@gemsorg/components/src/uikit/consts'

.container
  box-sizing: border-box;
  padding: 10px 60px 30px
  max-width: 800px;

  @media(max-width: 660px)
    width: 100%;
    padding: 0 10px

.description
  font(font-preset[subheader])
  color: color-text-1
  margin-top: 10px;

  @media(max-width: 660px)
    padding: 0 20px

.form
  margin-top: 20px;
  margin-bottom: 60px;

.row
  display: flex;
  align-content: center;

  @media(max-width: 660px)
    flex-direction: column;

.input
  height: 50px;

.submit
  width: 180px;
  margin-left: 10px;

  @media(max-width: 660px)
    width: 100%;
    margin-left: 0;
    margin-top: 10px;

.error
  margin-top: s-margin-medium

.gems
  color: color-blue
  font-weight: 600;
