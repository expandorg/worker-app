@import 'common/uikit/layout';
@import 'common/uikit/colors';
@import 'common/uikit/font';
@import 'common/uikit/components';

.container
  box-sizing: border-box;
  padding: 0 (2 * s-padding-big) (2 * s-padding-big)

  @media(max-width: 660px)
    width: 100%;

.form
.result
  box-sizing: border-box;
  width: 480px;
  padding-top: 20px;
  padding-bottom: 20px;

  @media(max-width: 660px)
    width: 100%;

.title
  margin-top: 15px;
  font(font-preset[caption], 400)
  text-align: center;
  text-transform: uppercase;
  letter-spacing: 0.9px;
  color: color-text-1


.error
  margin-top: 10px;

.input
  input()
  width: 100%;
  margin-bottom: 10px;

.submit
  button('medium', 'pink')
  width: 100%;
  margin-top: 10px;

.result
  font(font-preset[title], false, false, 90px)
  text-align: center;
  color: color-text-1
