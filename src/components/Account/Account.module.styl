@import 'common/uikit/layout';
@import 'common/uikit/colors';
@import 'common/uikit/font';
@import 'common/uikit/components';

.container
  padding-bottom:  5em

.headline
  margin: s-margin-medium 0

  font(font-preset[subheader])
  letter-spacing: 0.5
  text-transform: uppercase

  opacity: 0.4
  color: #0b132b

.actions
  display: flex;
  align-items: center;
  justify-content: space-between;

  @media(max-width: 660px)
    flex-direction: column;
    align-items: stretch;

.logout
  button('medium','white')
  padding: 0 20px;

  @media(max-width: 660px)
    margin-top: 30px;
