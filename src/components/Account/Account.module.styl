@import '../common/uikit/layout';
@import '../common/uikit/components';
@import '../common/uikit/colors';

defaultBtn()
  button()
  min-width: 100px
  width: 'calc(25% - %s)' % s-margin-big
  height: 40px
  margin: s-margin-medium
  display: inline-block
  font-size: 16px

.defaultBtn
  defaultBtn()

.innerContainer
  flexpanel()

.table
  width: 100%
  display: flex
  justify-content: center
  align-items: flex-start
  flex-wrap: wrap
  flex-direction: column
  margin: 0 0 3em 0
  padding: 0

.cell
  box-sizing: border-box
  flex-grow: 0 1 auto
  flex-direction: column
  width: 100%
  padding: 0.8em 1.2em
  overflow: hidden
  list-style: none

.heading
  font-size: 16px
  letter-spacing: 0.5
  opacity: 0.4
  color: #0b132b
  display: block
  text-transform: uppercase
  margin-bottom: s-margin-medium
  margin-top: s-margin-medium

.subHeading
  font-size: 16px
  color: color-text-1
  display: inline-block
  margin-right: s-margin-medium
  margin-left: 20px

.gem
  width: 20px
  height: 20px
  margin-left: 10px

.accountInputContainer
  display: inline-block
  width: calc(100% - 62px)
  vertical-align: middle

.accountInput
  border-radius: 4px
  border: solid 1px color-border-grey
  display: inline-block
  font-size: 14px
  text-align: left
  color: color-text-1
  padding: 8px s-padding-medium
  width: calc(100% - 205px)
  min-width: 200px

  &:focus
    outline: 0

.emailInput
  border-radius: 4px
  border: solid 1px color-border-grey
  display: inline-block
  font-size: 14px
  text-align: left
  color: color-text-1
  padding: 8px s-padding-medium
  width: calc(100% - 394px)
  min-width: 200px

  &:focus
    outline: 0

.copyBtn
  display: inline-block
  font-size: 13px
  text-align: right
  color: color-text-1
  text-transform: uppercase
  border: none
  background-color: transparent
  margin-left: s-margin-big;
  padding: 0
  cursor: pointer

.reserved
  display: inline-block

.address
  display: block
  text-overflow: ellipsis
  overflow: hidden

.logout
  defaultBtn()
  float: right
  background-color: color-white
  border: solid 2px color-pink

.availableFunds
  margin-left: 2px
  display: inline-block

.loading
  loading()

.sm
  max-height: 20px
  max-width: 20px
  display: inline-block
  top: 0%
  transform: none
  vertical-align: middle

.disabled
  cursor: default

.editBtn
  defaultBtn()
  display: inline-block
  width: 198px

.prompt
  text-align: center
