@import '~@expandorg/uikit/font'
@import '~@expandorg/uikit/colors'
@import '~@expandorg/uikit/consts'

.container
  padding-bottom:  5em

.headline
  margin: s-margin-medium 0

  font(font-preset[subheader])
  letter-spacing: 0.5
  text-transform: uppercase

  opacity: 0.4
  color: #0b132b

.actions
  display: flex;
  align-items: center;
  justify-content: space-between;

  @media(max-width: 660px)
    flex-direction: column;
    align-items: stretch;

.gems
  display: flex;

  @media(max-width: 660px)
    flex-direction: column;
    align-items: stretch;

.logout
  @media(max-width: 660px)
    margin-top: 30px;
