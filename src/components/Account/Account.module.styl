@import '~@expandorg/uikit/colors';
@import '~@expandorg/uikit/font';

.container
  box-sizing: border-box;
  padding: 50px 0

.panel
  box-sizing: border-box;
  padding: 30px 30px
  margin: 0 auto 50px auto
  width: 512px

.title
  font(h2-title)
  color: color-text-dark

.actions
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 30px

.logout
  line-height: 38px
  height 40px
  border-radius: 2px
