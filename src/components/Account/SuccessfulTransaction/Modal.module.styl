@import '../../common/uikit/colors';
@import '../../common/uikit/layout';

.container
  text-align: center
  display: block

.description
  margin: 3%
  display: block

.inputContainer
  display: inline-block
  width: calc(100% - 62px)
  vertical-align: middle

.copyBtn
  display: inline-block
  font-size: 13px
  text-align: right
  color: color-text-1
  text-transform: uppercase
  border: none
  background-color: transparent
  margin-left: s-margin-big
  padding: 0
  cursor: pointer

.input
  border-radius: 4px
  border: solid 1px color-border-grey
  display: inline-block
  font-size: 14px
  text-align: left
  color: color-text-1
  padding: 8px 12px
  width: calc(100% - 205px)
  min-width: 200px

  &:focus
    outline: 0

.value
  display: block
  text-overflow: ellipsis
  overflow: hidden
