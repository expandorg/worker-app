@import '~@expandorg/uikit/colors'
@import '~@expandorg/uikit/font'
@import '~@expandorg/uikit/consts'

.container
  display: flex;
  align-items: center;
  justify-content: space-between;

  @media(max-width: 660px)
    flex-direction: column;
    justify-content: flex-start;
    align-items: stretch;

.content
  display: flex;
  justify-content: space-between;
  align-items: center;

  flex-grow: 1
  box-sizing: border-box;

  font(font-preset[normal], false, false, 40px)
  height: 40px

  padding: 0 s-padding-medium

  border: solid 1px color-border-grey
  border-radius: 4px
  color: color-text-1


.value
  flex-grow: 1
  text-overflow: ellipsis
  overflow: hidden
  white-space: nowrap

.copy
  box-sizing: border-box;
  padding: 0
  margin-left: s-margin-big;

  font(font-preset[body])
  text-transform: uppercase
  border: none

  color: color-text-1
  background-color: transparent
  cursor: pointer

.edit
  width: 150px
  margin-left: 20px;

  @media(max-width: 660px)
    width: 100%;
    margin-top: 10px;
    margin-left: 0;
