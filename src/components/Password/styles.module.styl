@import '~@gemsorg/components/src/uikit/colors'
@import '~@gemsorg/components/src/uikit/font'
@import '~@gemsorg/components/src/uikit/consts'

.container
  display: flex;
  justify-content: center;
  box-sizing: border-box

  @media(max-width: 685px)
    align-items: stretch;
    min-height: 'calc(100vh - %s)' % s-header-height

.panel
  margin-top: 50px;
  box-sizing: border-box;
  background-color: color-white

  width: 685px;
  padding-top: 55px;

  display: flex;
  flex-direction: column;
  align-items: center;

  @media(max-width: 685px)
    margin-top: 0
    width: 100%

.title
  font(font-preset[title])
  color: color-text-1
  text-align: center;

.label
  font(font-preset[body])
  color: color-text-1
  margin-top: 10px

.form
  box-sizing: border-box;
  padding-top: 30px;
  padding-bottom: 90px;
  width: 380px;

.error
  margin-top: 10px;

.input
  color: color-text-1
  background-color: color-white

  border-radius: 4px;

.submit
  width: 100%
  margin-top: 24px;

.sent
  padding-top: 30px;
  padding-bottom: 80px;
  text-align: center;

.message
  font(font-preset[subheader])
  color: color-text-1

.link
  display: block;
  font(font-preset[subheader])
  color: color-pink
  margin-top: 10px
