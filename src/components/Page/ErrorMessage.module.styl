@import 'common/uikit/colors'
@import 'common/uikit/layout'

.error
  height: 40px
  font-size: 24px
  text-align: center
  vertical-align: middle
  background-color: color-aqua

.close
  float: right
  font-size: 16px
  display: inline-block
  cursor: pointer
  background-color: transparent
  border: 0
  height: 40px
  margin-right: s-margin-big

  &:focus
    outline: 0px
