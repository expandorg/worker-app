@import '../common/uikit/colors'
@import '../common/uikit/layout'

html, body, :global(#root)
  margin: 0
  padding: 0
  height: 100%
  width: 100%

.app
  height: 100%
  width: 100%
  font-family: "Poppins"
  color: color-blue

.container
  width: 'calc(100% - %s)' % s-sidebar-width
  height: 100%
  background-color: color-grey
  display: inline-block
  vertical-align: top

  @media(max-width: 1150px)
    width: 100%

.feedback
  margin-left: 15px
  color: color-aqua
