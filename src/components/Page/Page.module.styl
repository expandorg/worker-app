@import '../common/uikit/mixins'

html, body, :global(#root)
  margin: 0px
  padding: 0
  height: 100%
  width: 100%

.app
  height: 100%
  width: 100%
  font-family: "Poppins"
  color: BLUE

.container
  width: 'calc(100% - %s)' % SIDEBAR_W
  height: 100%
  background-color: #f2f2f2
  display: inline-block
  vertical-align: top

  @media(max-width: 1150px)
    width: 100%

.alphaMsg
  display: block
  position: relative
  top: -25px
  bottom: 0
  background-color: #1c2541
  color: #ffffff
  width: calc(100% - 50px)
  padding-left: 25px
  padding-right: 25px
  margin-left: SIDEBAR_W

  @media(max-width: 1150px)
    margin-left: 0

.feedback
  margin-left: 15px
  color: #6fffe9
