.container
  margin-top: 10px;
  padding: 0 0 0 s-padding-big;
  font(font-preset[menu])

.link
  display: block
  height: 40px
  text-decoration: none
  color: color-white
  opacity: 0.6
  cursor: pointer

  &:hover
    opacity: 0.9

.active
  opacity: 1
