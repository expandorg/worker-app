@import '~@gemsorg/components/src/uikit/colors'
@import '~@gemsorg/components/src/uikit/consts'

.gem-sidebar
  position: fixed
  top: 0
  left: 0

  box-sizing: border-box;

  width: s-sidebar-width
  height: 100vh

  background-color: color-blue
  z-index: 2

  @media(max-width: 1150px)
    display: none

  &-visible
    display: block

  &-logo
    width: 119px
    height: 50px

    margin-left: s-margin-big;
    margin-top: 10px
