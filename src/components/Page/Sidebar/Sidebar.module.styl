@import '../../common/uikit/colors';
@import '../../common/uikit/layout';

.sideBar
  width: 'calc(%s - 25px)' % s-sidebar-width
  padding-left: 25px
  height: 100%
  display: inline-block
  background: color-blue

  @media(max-width: 1150px)
    display: none

    > img
      display: none

.ib
  display: inline-block
  background: #0B132B
  position: absolute
  top: 0
  left: 0
  z-index: 2

.logo
  margin-top: 10px
  width: 119px
  height: 50px
