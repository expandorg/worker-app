@import '../../common/uikit/mixins';

.sideBar
  width: 'calc(%s - %s)' % (SIDEBAR_W PADDING)
  padding-left: PADDING
  height: 100%
  display: inline-block
  background: BLUE

  @media(max-width: 1150px)
    display: none

    > img
      display: none

.ib
  display: inline-block
  background: #0B132B
  position: absolute
  top: 0
  left: 0
  z-index: 2

.logo
  margin-top: 10px
  width: 119px
  height: 50px
