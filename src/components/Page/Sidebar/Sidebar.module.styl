@import '../../common/uikit/colors';
@import '../../common/uikit/layout';

.sideBar
  box-sizing: border-box;
  width: s-sidebar-width
  height: 100%
  display: inline-block
  background: color-blue

  @media(max-width: 1150px)
    display: none

    .logo
      display: none

.ib
  display: inline-block
  background: #0B132B
  position: absolute
  top: 0
  left: 0
  z-index: 2

.logo
  margin-left: 25px;
  margin-top: 10px

  width: 119px
  height: 50px
