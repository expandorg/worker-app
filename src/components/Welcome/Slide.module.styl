@import '~@gemsorg/uikit/colors'
@import '~@gemsorg/uikit/font'

.container
  box-sizing: border-box;
  padding: 10px 10px

  display: flex;
  flex-direction: column;
  justify-content: space-between;

  cursor: pointer;
  user-select: none;

.content
  height: 100%;
  width: 100%;

  flex-grow: 1

  background-size:contain;
  background-position: center center;
  background-repeat: no-repeat;

.text
  box-sizing: border-box;
  padding: 10px 0

  text-align: center;

  font(font-preset[menu])
  color: color-text-1
