@import 'common/uikit/colors'
@import 'common/uikit/font'

.container
  box-sizing: border-box;
  position: relative;

.arrow
  box-sizing: border-box;

  position: absolute;
  top: calc(50% - 15px)

  height: 30px
  width: 30px;
  line-height: 30px;

  font-size: 25px;
  font-weight: 600

  border-radius: 15px;
  background: color-white
  color: color-pink-light
  box-shadow: 0 7px 14px 0 rgba(0, 0, 0, 0.08);

  cursor: pointer;
  outline: none

.left
  left: 0

.right
  right: 0

.inner
  position: relative;
  box-sizing: border-box;
  height: calc(100vh - 300px)
