@import 'components/common/uikit/components'
@import 'components/common/uikit/colors'

.container
  box-sizing: border-box
  padding-top: 100px;
  display: block;

.panel
  box-sizing: border-box;

  max-width: 700px;
  max-height: 800px;

  margin: 0 auto;
  padding: 10px

  background-color: color-white

.slider
  box-sizing: border-box;
  position: relative;
  max-height: 600px;

.actions
  padding: 20px 0 40px 0
  display: flex;
  align-items: center;
  justify-content: center;

.start
  button('large', 'pink')
  width: 174px
  text-decoration: none;
