@import '~@gemsorg/components/src/uikit/colors'

.container
  padding: 10px 0
  display: flex;
  justify-content: center;

.inner
  display: flex;
  align-items: center;
  justify-content: center;
  display: inline-block;

.item
  box-sizing: border-box;
  width: 8px;
  height: 8px;
  line-height: 8px;


  margin: 0 5px;

  background-color: color-border-grey;
  border: 1px solid color-border-grey;
  border-radius: 4px;

  cursor: pointer;
  outline: none;

.active
  background-color: color-pink
