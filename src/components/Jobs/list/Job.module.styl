@import '~@expandorg/uikit/colors'
@import '~@expandorg/uikit/size'
@import '~@expandorg/uikit/font'

.container
  box-sizing: border-box
  position relative

  display: flex
  align-items: center
  justify-content: space-between

  background-color: color-white;
  box-shadow: light-shadow

  transition: box-shadow 100ms ease-in;

  margin-bottom: 15px

  @media(max-width: breakpoint-mobile-sm)
    flex-direction: column
    align-items: stretch

  &:hover
    box-shadow: heavy-shadow

.info
  box-sizing: border-box
  display: flex
  align-items: center
  justify-content: flex-start
  padding: 30px 0 30px 30px
  max-width 50%

  @media(max-width: breakpoint-mobile-sm)
    max-width 100%
    padding-right: 40px

.logo
  width: 60px
  min-width: 60px
  max-width: 60px
  height: 60px
  display: inline-block

.heading
  box-sizing: border-box
  padding-left: 30px
  width: 100%;

.name
  font(h2-title)
  color: color-text-dark

  @media(max-width: breakpoint-mobile-sm)
    font(h3-title)


.description
  font(h3-bold)
  color: color-text-heavy-blue

  text-overflow: ellipsis
  overflow: hidden
  white-space: nowrap

.actions
  box-sizing: border-box
  display: flex
  align-items: center
  justify-content: flex-start

  padding-right: 30px

  @media(max-width: breakpoint-mobile-sm)
    padding-right: 0


.reward
  margin-left: 30px
  font(body-bold, false, false, 1)
  color: color-text-dark
  white-space: nowrap

  @media(max-width: breakpoint-mobile-sm)
    position: absolute
    top: 35px
    right: 20px

.icon
  margin-left: 2px
  position relative
  top: 2px

  path
    fill color-pink

.assign
  padding: 0 30px
  width: 150px
  height: 40px;

  line-height: 38px
  letter-spacing: 0.15em;
  text-decoration: none

  border-radius: 2px

  margin-left: 20px

  @media(max-width: breakpoint-mobile-sm)
    display: none

.warning
  box-sizing: border-box
  position relative

  height 40px
  width: 100px

  text-align: center
  font(subtitle, false, false, 40px)
  color: color-text-yellow-2
  border:  none
  background-color: color-text-yellow

  cursor pointer
  outline 0


  @media(max-width: breakpoint-mobile-sm)
    width: 100%

.i
  margin-left: 5px
  path
    fill: color-white

  &:hover
    path
      fill: color-white

  :global(.gem-tooltip)
    font(h4-bold)
    letter-spacing: 0



