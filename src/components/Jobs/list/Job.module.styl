@import '~@expandorg/uikit/colors'
@import '~@expandorg/uikit/font'

.container
  box-sizing: border-box

  display: flex
  align-items: center
  justify-content: space-between

  padding: 0 30px

  height 120px;

  background-color: color-white;
  box-shadow: light-shadow

  transition: box-shadow 100ms ease-in;

  margin-bottom: 15px

  &:hover
    box-shadow: heavy-shadow

.info
  box-sizing: border-box
  display: flex
  align-items: center
  justify-content: flex-start
  max-width 50%

.logo
  width: 60px
  height: 60px
  display: inline-block

.heading
  box-sizing: border-box
  padding-left: 30px
  width: 100%;

.name
  font(h2-title)
  color: color-text-dark

.description
  font(h3-bold)
  color: color-text-heavy-blue

  text-overflow: ellipsis
  overflow: hidden
  white-space: nowrap

.actions
  display: flex
  align-items: center
  justify-content: flex-start

.reward
  font(body-bold, false, false, 1)
  color: color-text-dark

.icon
  margin-left: 4px
  position relative
  top: 2px

  path
    fill color-pink

.learn
  padding: 0 30px
  width: auto
  height: 40px;

  line-height: 38px
  letter-spacing: 0.15em;

  border-radius: 2px

  margin-left: 30px

.assign
  padding: 0 30px
  width: auto
  height: 40px;

  line-height: 38px
  letter-spacing: 0.15em;
  text-decoration: none

  border-radius: 2px

  margin-left: 20px






