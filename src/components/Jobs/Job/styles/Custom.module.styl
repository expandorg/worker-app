@import 'common/uikit/font'
@import 'common/uikit/colors'
@import 'common/uikit/components'

.taskContainer
  button
    width: 100%
    font-weight: 600!important
    transition:0.4s
    &:hover
      transition:0.4s

.btnBoxTask
  button
    margin-top: 70px
.imgBox
  text-align: center
  padding: 20px
  width: 160px
  height: 160px
  margin: 0 auto 51px auto
  @media(min-width: 768px)
    width: 200px
    height: 200px
    margin: 0 auto 40px auto
  img
    width: 100%
    height: 100%  

// Custom styled checknbox
.termsBox
  margin: 76px auto 34px auto
  width: 85%
  label
    display: flex
    position: relative
    justify-content:center
    flex-direction: row-reverse
    width: 100%
    align-items:center
    cursor: pointer
    user-select: none
    font-size: 12px
    font-weight: 600
    @media(min-width: 768px)
      font-size:14px

  /* Hide the browser's default checkbox */
  input
    position: absolute
    opacity: 0
    cursor: pointer
  /* Create a custom checkbox */
  .checkmark
    position: relative
    height: 25px
    width: 25px
    min-width: 25px
    min-height: 25px
    background-color: color-text-1 
    border-radius: 50%
    border: 2px solid color-text-gray-1 
    margin-right: 6px
    &:after
      content: ""
      position: absolute
      display: none
      left: 8px
      top: 4px
      width: 6px
      height: 11px
      border: solid color-white
      border-width: 0 2px 2px 0
      -webkit-transform: rotate(45deg)
      -ms-transform: rotate(45deg)
      transform: rotate(45deg)

  input:checked~.checkmark
    background-color: color-pink
    border: 2px solid color-pink
  input:checked~.checkmark:after
    display: block
  @media(min-width: 1150px)
    width: 53%
    margin: 36px auto 28px auto;
// End custom checkbox

.questionHeader
  .headerHeading
    background: #1c2541
    display: flex
