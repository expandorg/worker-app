@import '../../common/uikit/mixins';

.job
  panel()

.logo
  width: 100px
  height: 100px
  border-radius: 2px
  background: #eee
  display: inline-block
  vertical-align: top

.info
  display: inline-block
  margin-left: 12px
  vertical-align: top

.heading
  font-size: 18px
  font-weight: 400
  letter-spacing: -0.6px
  color: #1c2541

.requester
  font-size: 14px
  font-weight: 400
  color: #939393
  margin-bottom: 12px

.rewardMobile
  display: none
  vertical-align: top
  border-radius: 4px
  border: solid 1px #e0e0e0
  padding: 0 2px 2px 9px
  height: 'calc(%s * 1.25)' % PADDING
  text-align: center
  cursor: default
  margin-left: 50px
  line-height: 'calc(%s * 1.25)' % PADDING

  @media(max-width: 1150px)
    display: inline-block

.reward
  display: inline-block
  vertical-align: top
  border-radius: 4px
  border: solid 1px #e0e0e0
  padding: 0 2px 2px 9px
  height: 'calc(%s * 1.25)' % PADDING
  text-align: center
  cursor: default
  margin-left: 'calc(%s * 2)' % PADDING
  line-height: 'calc(%s * 1.25)' % PADDING

  @media(max-width: 1150px)
    display: none

.rewardNumber
  vertical-align: middle

.rewardIcon
  height: 30px
  width: 32px
  vertical-align: middle

.joinBtn
  width: 'calc(%s * 2)' % PADDING
  height: 'calc(%s * 1.25)' % PADDING
  border-radius: BORDER_R
  background-color: #ff7092
  color: #ffffff
  cursor: pointer
  border: 0

  &:focus
    outline: 0

  &:hover
    background-image: linear-gradient(to bottom right, #ff7092, #FF8EA9)

.modalJob
  font-size: 24px
  margin-left: 24px
  line-height: 80px
  letter-spacing: -0.6px
  text-align: left
  color: #1c2541
  display: inline-block

.modalCompany
  font-size: 14px
  text-align: left
  color: #939393
  margin-left: 35px
  display: inline-block

.screenShotDescription
  font-size: 20px
  letter-spacing: -0.3px
  text-align: center
  color: #3a506b
  display: block
  margin-bottom: 12px

.screenShot
  max-width: 80%
  width: calc(80% - 50px)
  display: block
  margin: auto
  margin-bottom: PADDING

.description
  font-size: 16px
  letter-spacing: -0.2px
  text-align: center
  color: #3a506b
  display: block
  width: 100%
  margin: auto
  margin-bottom: PADDING

.agreeBtn
  width: 205px
  height: 50px
  line-height: 50px
  border-radius: BORDER_R
  background-color: #6fffe9
  display: block
  margin: auto
  margin-bottom: PADDING
  font-size: 18px
  letter-spacing: -0.7px
  text-align: center
  border: 0
  cursor: pointer
  text-decoration: none

  &:focus
    outline: 0

  &:hover
    background-image: linear-gradient(to bottom right#6fffe9#94FFEF)
