@import 'common/uikit/components';
@import 'common/uikit/colors';
@import 'common/uikit/layout';

.container
  box-sizing: border-box;

  padding: s-padding-big
  margin: s-margin-big

  border-radius: 4px
  background-color: color-white
  border: solid 1px color-grey

.logo
  width: 100px
  height: 100px
  border-radius: 2px
  background: #eee
  display: inline-block
  vertical-align: top

.info
  display: inline-block
  margin-left: s-margin-medium
  vertical-align: top

.heading
  font-size: 18px
  font-weight: 400
  letter-spacing: -0.6px
  color: color-blue

.requester
  font-size: 14px
  font-weight: 400
  color: #939393
  margin-bottom: s-margin-medium

.rewardMobile
  display: none
  vertical-align: top
  border-radius: 4px
  border: solid 1px color-border-grey
  padding: 0 2px 2px 9px
  height: 31px
  text-align: center
  cursor: default
  margin-left: 50px
  line-height: 31px

  @media(max-width: 1150px)
    display: inline-block

.reward
  display: inline-block
  vertical-align: top
  border-radius: 4px
  border: solid 1px color-border-grey
  padding: 0 2px 2px 9px
  height: 31px
  text-align: center
  cursor: default
  margin-left: 50px
  line-height: 31px

  @media(max-width: 1150px)
    display: none

.rewardNumber
  vertical-align: middle

.rewardIcon
  height: 30px
  width: 32px
  vertical-align: middle

.join
  width: 50px
  height: 31px
  border-radius: 4px
  background-color: color-pink
  color: color-white
  cursor: pointer
  border: 0

  &:focus
    outline: 0

  &:hover
    background-image: linear-gradient(to bottom right, color-pink, color-pink-light)
