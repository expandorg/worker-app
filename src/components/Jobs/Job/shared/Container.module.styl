@import 'common/uikit/layout'
@import 'common/uikit/colors'

.taskContainer
  margin: 21px 0
  padding: 10px 15px 62px 15px
  text-align: center
  color:color-text-1
  height: 100vh;
  @media(min-width: 768px)
    padding: 10px 50px 62px 50px
  @media(min-width: 1440px)
    padding: 10px 100px 62px 100px
  h3
    margin-top: 40px
    color:color-text-1
    font-size: 24px
    @media(min-width: 768px)
      font-size: 29px
      margin-top: 54px
  p
    padding: 20px 0px
    font-size: 15px
    font-weight: 600
    @media(min-width: 1150px)
      font-size: initial
      width:80%
      margin:0 auto
    @media(min-width: 1440px)
      width:60%

