@import '../common/uikit/colors';
@import '../common/uikit/layout';

.company
  font-size: 14px
  text-align: left
  color: #939393
  margin-left: 35px
  display: inline-block

.screenShotDescription
  font-size: 20px
  letter-spacing: -0.3px
  text-align: center
  color: color-text-1
  display: block
  margin-bottom: s-margin-medium

.screenShot
  max-width: 80%
  width: calc(80% - 50px)
  display: block
  margin: auto
  margin-bottom: s-margin-big

.description
  font-size: 16px
  letter-spacing: -0.2px
  text-align: center
  color: color-text-1
  display: block
  width: 100%
  margin: auto
  margin-bottom: s-margin-big

.agree
  width: 205px
  height: 50px
  line-height: 50px
  border-radius: 4px
  background-color: color-aqua
  display: block
  margin: auto
  margin-bottom: s-margin-big
  font-size: 18px
  letter-spacing: -0.7px
  text-align: center
  border: 0
  cursor: pointer
  text-decoration: none

  &:focus
    outline: 0

  &:hover
    background-image: linear-gradient(to bottom right, color-aqua, color-aqua-light)
