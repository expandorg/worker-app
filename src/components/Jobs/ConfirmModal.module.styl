@import '../common/uikit/mixins';

.company
  font-size: 14px
  text-align: left
  color: #939393
  margin-left: 35px
  display: inline-block

.screenShotDescription
  font-size: 20px
  letter-spacing: -0.3px
  text-align: center
  color: #3a506b
  display: block
  margin-bottom: 12px

.screenShot
  max-width: 80%
  width: calc(80% - 50px)
  display: block
  margin: auto
  margin-bottom: PADDING

.description
  font-size: 16px
  letter-spacing: -0.2px
  text-align: center
  color: #3a506b
  display: block
  width: 100%
  margin: auto
  margin-bottom: PADDING

.agree
  width: 205px
  height: 50px
  line-height: 50px
  border-radius: BORDER_R
  background-color: #6fffe9
  display: block
  margin: auto
  margin-bottom: PADDING
  font-size: 18px
  letter-spacing: -0.7px
  text-align: center
  border: 0
  cursor: pointer
  text-decoration: none

  &:focus
    outline: 0

  &:hover
    background-image: linear-gradient(to bottom right#6fffe9#94FFEF)
