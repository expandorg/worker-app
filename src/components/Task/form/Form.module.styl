@import 'common/uikit/components';
@import 'common/uikit/colors';
@import 'common/uikit/layout';

.container
  @media(max-width: 660px)
    padding-left: 0
    padding-right: 0

.description
  font(font-preset[title], false, 22px)
  text-align: center
  color: color-text-1

  margin: s-margin-big 0;
  padding: 0;
  max-width: 800px;

  @media(max-width: 660px)
    font-size: 16px;
    margin: s-margin-medium 0;
    padding: 0 s-margin-medium;

.form
  display: block
  margin: 0 auto
  max-width: 800px;
  margin-bottom: s-margin-big

.actions
  display: flex;
  justify-content: center;

.submit
  button('large', 'pink')
  padding: 0 20px;
  margin-top: 15px
