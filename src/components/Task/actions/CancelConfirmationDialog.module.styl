@import '~@gemsorg/uikit/colors'
@import '~@gemsorg/uikit/font'
@import '~@gemsorg/uikit/consts'

.container
  box-sizing: border-box;
  padding: 0 s-padding-big s-padding-big
  min-width: 500px
  max-width: 800px;

  @media(max-width: 660px)
    width: 100%;
    min-width: 100%
    padding: 10px 20px

.message
  font(font-preset[subheader])
  color: color-text-1

.actions
  display: flex;
  justify-content: flex-end;

  box-sizing: border-box;
  padding: 20px 0 15px;

.cancel
  border: 0;
