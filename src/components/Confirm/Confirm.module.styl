@import '../common/uikit/colors';

.container
  text-align: center
  display: block

.description
  margin: 5%
  display: block

.input
  width: calc(100% - 200px)
  min-width: 200px
  height: 50px
  border-radius: 4px
  background-color: color-white
  border: solid 1px color-border-grey
  display: inline-block
  font-size: 16px
  text-align: left
  padding-left: 15px
  color: color-text-gray-1

  &::placeholder
    font-size: 16px
    text-align: left
    color: color-text-gray-1

  &:focus
    outline: 0

.submitForm
  display: block
  margin: auto
  text-align: center
  margin-bottom: 25px
  width: 80%

.submit
  width: 119px
  height: 50px
  border-radius: 4px
  background-color: color-pink
  display: inline-block
  font-size: 18px
  letter-spacing: -0.7px
  text-align: center
  color: color-white
  margin-left: 8px
  border: 0
  cursor: pointer

  &:focus
    outline: 0

  &:hover
    background-image: linear-gradient(to bottom right, color-pink, color-pink-light)

  &:disabled
    background-color: color-grey

    &:hover
      background-image: none

.resend
  margin-left: 5px
