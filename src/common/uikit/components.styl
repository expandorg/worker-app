@import './colors';
@import './font';
@import './layout';

button(size = 'medium', theme = 'pink')
  box-sizing: border-box;
  text-align: center;

  border: 0
  text-decoration: none;
  outline: 0
  cursor: pointer;
  display: inline-block;

  if size == 'medium'
    font(font-preset[menu], false, false, 38px)
    height: 40px
    border-radius: 4px

  if size == 'large'
    font(font-preset[menu], false, false, 48px)
    height: 50px
    border-radius: 4px

  if theme == 'pink'
    color: color-white
    background-color: color-pink
    &:hover
      background-image: linear-gradient(to bottom right, color-pink, color-pink-light)

    &:disabled
      background-color: color-grey

      &:hover
        background-image: none

  if theme == 'white'
    color: color-pink
    background-color: color-white
    border: 2px solid color-pink

    &:disabled
      background-color: color-grey

  if theme == 'blue'
    color: color-white
    background-color: color-blue
    &:hover
      background-image: linear-gradient(to bottom right, color-blue, lighten(color-blue, 10%))



input()
  box-sizing: border-box
  display: inline-block

  font(font-preset[normal], false, false, 40px)
  height: 40px;
  padding: 0 17px 0 10px

  background-color: color-white
  color: color-text-1

  border-radius: 2px
  border: solid 1px color-border-grey

  outline: 0

  &:focus
    box-shadow: 0 0 4px 0 color-text-gray-1;
    border: solid 1px color-text-gray-1;


loading()
  display: block
  margin: auto
  height: 150px
  width: 150px
  background: url(/images/loading-animation.gif) no-repeat left top
  background-size: contain
  position: relative
  top: 35%
  transform: translateY(-50%)
